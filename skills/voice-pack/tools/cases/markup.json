    { "name": "spell_keeps_a_combining_mark_with_its_letter", "input": "[spell]e\u0301x[/spell]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "e\u0301 x" }] }] },
    { "name": "spell_keeps_a_character_outside_the_bmp_whole", "input": "[spell]𠀀a[/spell]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "𠀀 a" }] }] },
    { "name": "spell_keeps_a_flag_whole", "input": "[spell]🇺🇸x[/spell]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "🇺🇸 x" }] }] },
    { "name": "spell_keeps_a_joined_emoji_whole", "input": "[spell]👨\u200d👩\u200d👧x[/spell]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "👨\u200d👩\u200d👧 x" }] }] },
    { "name": "spell_of_nothing_leaves_nothing", "input": "[spell] [/spell]", "expected": [] },
    { "name": "adjacent_spell_tags_merge", "input": "[spell]ab[/spell][spell]cd[/spell]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a b c d" }] }] },

    { "name": "join_continue_without_a_blank_line", "input": "x\n[slow]y[/slow]",
