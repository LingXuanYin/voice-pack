    { "name": "spell_has_no_speed_of_its_own", "input": "[spell]ab[/spell]", "options": { "defaultSpeed": 1.1 },
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a b", "speed": 1.1 }] }] },
    { "name": "spell_inside_slow", "input": "[slow][spell]ab[/spell][/slow]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a b", "speed": 0.85 }] }] },
    { "name": "spell_cjk_and_digits", "input": "[spell]第3号[/spell]",
