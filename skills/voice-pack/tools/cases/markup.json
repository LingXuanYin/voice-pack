{
  "$comment": "台本标记解析的标准用例。基础部分的 tools/markup.mjs 和 app 里自带的解析器是同一份契约的两份实现，两边都跑这份用例；两边结果不一致，先定哪个对，再一起改。span 里省略的字段取 defaults 里的值；join 没有默认值，省略表示结果里没有这个键。语法和取舍见 tools/markup.mjs 的文件头。",
  "version": 1,
  "defaults": { "voice_id": null, "pause_ms_after": 0, "speed": null },
  "cases": [
    { "name": "plain_line", "input": "你好，世界。",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "你好，世界。" }] }] },
    { "name": "empty_string", "input": "", "expected": [] },
    { "name": "null_input", "input": null, "expected": [] },
    { "name": "whitespace_only", "input": "  \n\t \n", "expected": [] },
    { "name": "ends_are_trimmed", "input": "  hello  \n",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "hello" }] }] },
    { "name": "inner_newlines_are_kept", "input": "line one\nline two",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "line one\nline two" }] }] },
    { "name": "crlf_becomes_lf", "input": "a\r\nb",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a\nb" }] }] },
    { "name": "lone_cr_becomes_lf", "input": "a\rb",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a\nb" }] }] },
    { "name": "leading_bom_is_ignored", "input": "\ufeff# B\nc",
      "expected": [{ "title": "B", "spans": [{ "text": "c" }] }] },
    { "name": "fullwidth_space_indent_is_trimmed", "input": "\u3000\u3000第一段。\u3000",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "第一段。" }] }] },

    { "name": "chapters_by_heading", "input": "# One\nfirst\n# Two\nsecond",
      "expected": [
        { "title": "One", "spans": [{ "text": "first" }] },
        { "title": "Two", "spans": [{ "text": "second" }] }] },
    { "name": "text_before_first_heading_is_chapter_1", "input": "intro\n# A\nx",
      "expected": [
        { "title": "Chapter 1", "spans": [{ "text": "intro" }] },
        { "title": "A", "spans": [{ "text": "x" }] }] },
    { "name": "heading_without_body_is_dropped", "input": "# A\n# B\nz",
      "expected": [{ "title": "B", "spans": [{ "text": "z" }] }] },
    { "name": "heading_only", "input": "# Title", "expected": [] },
    { "name": "heading_may_be_indented", "input": "  # Spaced\nx",
      "expected": [{ "title": "Spaced", "spans": [{ "text": "x" }] }] },
    { "name": "tab_after_hash_is_a_heading", "input": "#\tTab\nx",
      "expected": [{ "title": "Tab", "spans": [{ "text": "x" }] }] },
    { "name": "title_is_trimmed", "input": "#  Title  \nx",
      "expected": [{ "title": "Title", "spans": [{ "text": "x" }] }] },
    { "name": "hash_without_space_is_text", "input": "#NoSpace\nx",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "#NoSpace\nx" }] }] },
    { "name": "double_hash_is_text", "input": "## Two\nx",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "## Two\nx" }] }] },
    { "name": "hash_in_the_middle_of_a_line_is_text", "input": "a # b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a # b" }] }] },
    { "name": "title_is_literal_text", "input": "# [pause 1s] T\nx",
      "expected": [{ "title": "[pause 1s] T", "spans": [{ "text": "x" }] }] },
    { "name": "line_separator_ends_a_line", "input": "a\u2028# B\nc",
      "expected": [
        { "title": "Chapter 1", "spans": [{ "text": "a" }] },
        { "title": "B", "spans": [{ "text": "c" }] }] },

    { "name": "default_voice_applies", "input": "x", "options": { "defaultVoice": "narrator" },
      "expected": [{ "title": "Chapter 1", "spans": [{ "voice_id": "narrator", "text": "x" }] }] },
    { "name": "default_speed_applies", "input": "x", "options": { "defaultSpeed": 1.1 },
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "x", "speed": 1.1 }] }] },

    { "name": "pause_bare_is_350ms", "input": "a[pause]b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "pause_ms_after": 350 }, { "text": "b" }] }] },
    { "name": "pause_in_seconds", "input": "a [pause 1.5s] b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "pause_ms_after": 1500 }, { "text": "b" }] }] },
    { "name": "pause_in_milliseconds", "input": "a [pause 800ms] b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "pause_ms_after": 800 }, { "text": "b" }] }] },
    { "name": "pause_without_unit_is_milliseconds", "input": "a [pause 2] b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "pause_ms_after": 2 }, { "text": "b" }] }] },
    { "name": "pause_tolerates_case_and_spaces", "input": "a[ PAUSE 1 S ]b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "pause_ms_after": 1000 }, { "text": "b" }] }] },
    { "name": "pause_uppercase_ms_unit", "input": "a[pause 5 MS]b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "pause_ms_after": 5 }, { "text": "b" }] }] },
    { "name": "pause_is_capped_at_10s", "input": "a[pause 99s]b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "pause_ms_after": 10000 }, { "text": "b" }] }] },
    { "name": "pause_in_ms_is_capped_too", "input": "a[pause 20000ms]b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "pause_ms_after": 10000 }, { "text": "b" }] }] },
    { "name": "pause_zero_keeps_both_spans", "input": "a[pause 0]b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a" }, { "text": "b" }] }] },
    { "name": "pause_half_ms_rounds_to_even_0", "input": "a[pause 0.5]b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a" }, { "text": "b" }] }] },
    { "name": "pause_1_5_ms_rounds_to_even_2", "input": "a[pause 1.5]b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "pause_ms_after": 2 }, { "text": "b" }] }] },
    { "name": "pause_2_5_ms_rounds_to_even_2", "input": "a[pause 2.5]b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "pause_ms_after": 2 }, { "text": "b" }] }] },
    { "name": "pause_fraction_of_a_second", "input": "a[pause 0.25s]b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "pause_ms_after": 250 }, { "text": "b" }] }] },
    { "name": "pause_fraction_of_a_ms_rounds", "input": "a[pause 12.6ms]b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "pause_ms_after": 13 }, { "text": "b" }] }] },
    { "name": "consecutive_pauses_add_up", "input": "a[pause 1s][pause 2s]b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "pause_ms_after": 3000 }, { "text": "b" }] }] },
    { "name": "consecutive_pauses_are_capped", "input": "a[pause 8s][pause 8s]b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "pause_ms_after": 10000 }, { "text": "b" }] }] },
    { "name": "pauses_with_a_space_between_are_not_merged", "input": "a[pause 1s] [pause 1s]b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "pause_ms_after": 1000 }, { "text": "", "pause_ms_after": 1000 }, { "text": "b" }] }] },
    { "name": "pause_before_text", "input": "[pause 1s]hello",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "", "pause_ms_after": 1000 }, { "text": "hello" }] }] },
    { "name": "pause_alone", "input": "[pause 1s]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "", "pause_ms_after": 1000 }] }] },
    { "name": "pause_after_text", "input": "hello[pause 1s]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "hello", "pause_ms_after": 1000 }] }] },
    { "name": "zero_pause_alone_leaves_nothing", "input": "[pause 0]", "expected": [] },
    { "name": "pause_splits_a_sentence", "input": "他说[pause 1s]好",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "他说", "pause_ms_after": 1000 }, { "text": "好" }] }] },
    { "name": "pause_between_paragraphs", "input": "a\n\n[pause 1s]\n\nb",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "pause_ms_after": 1000 }, { "text": "b" }] }] },
    { "name": "pause_number_needs_a_space_before_it", "input": "a[pause1s]b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a[pause1s]b" }] }] },
    { "name": "pause_fraction_needs_a_leading_digit", "input": "a[pause .5s]b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a[pause .5s]b" }] }] },
    { "name": "pause_trailing_dot_is_text", "input": "a[pause 1.s]b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a[pause 1.s]b" }] }] },
    { "name": "pause_unknown_unit_is_text", "input": "a[pause 1sec]b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a[pause 1sec]b" }] }] },
    { "name": "pause_negative_is_text", "input": "a[pause -1s]b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a[pause -1s]b" }] }] },
    { "name": "pause_comma_decimal_is_text", "input": "a[pause 1,5s]b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a[pause 1,5s]b" }] }] },
    { "name": "a_rewritten_pause_tag_is_just_text", "input": "wait [break 1s] now",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "wait [break 1s] now" }] }] },

    { "name": "voice_switch_and_back_to_default", "input": "[voice:Al]hi[voice:]back", "options": { "defaultVoice": "d" },
      "expected": [{ "title": "Chapter 1", "spans": [{ "voice_id": "Al", "text": "hi" }, { "voice_id": "d", "text": "back" }] }] },
    { "name": "voice_switch_back_without_a_default_is_null", "input": "[voice:a]x[voice:]y",
      "expected": [{ "title": "Chapter 1", "spans": [{ "voice_id": "a", "text": "x" }, { "text": "y" }] }] },
    { "name": "voice_name_is_trimmed_and_keeps_case", "input": "[voice: Alice ]hi",
      "expected": [{ "title": "Chapter 1", "spans": [{ "voice_id": "Alice", "text": "hi" }] }] },
    { "name": "voice_name_may_contain_spaces_and_colons", "input": "[voice:a b:c]x",
      "expected": [{ "title": "Chapter 1", "spans": [{ "voice_id": "a b:c", "text": "x" }] }] },
    { "name": "voice_keyword_is_case_insensitive", "input": "[Voice:Al]hi[VOICE:Bo]yo",
      "expected": [{ "title": "Chapter 1", "spans": [{ "voice_id": "Al", "text": "hi" }, { "voice_id": "Bo", "text": "yo" }] }] },
    { "name": "voice_lasts_until_the_next_voice_marker", "input": "[voice:a]one [voice:b]two [voice:a]three",
      "expected": [{ "title": "Chapter 1", "spans": [{ "voice_id": "a", "text": "one" }, { "voice_id": "b", "text": "two" }, { "voice_id": "a", "text": "three" }] }] },
    { "name": "voice_lasts_across_pauses", "input": "[voice:a]x[pause 1s]y",
      "expected": [{ "title": "Chapter 1", "spans": [{ "voice_id": "a", "text": "x", "pause_ms_after": 1000 }, { "voice_id": "a", "text": "y" }] }] },
    { "name": "voice_splits_a_sentence", "input": "你好[voice:b]世界",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "你好" }, { "voice_id": "b", "text": "世界" }] }] },
    { "name": "pause_then_voice_marker", "input": "a[pause 1s][voice:b]c",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "pause_ms_after": 1000 }, { "voice_id": "b", "text": "c" }] }] },
    { "name": "voice_marker_then_pause", "input": "[voice:b][pause 1s]c",
      "expected": [{ "title": "Chapter 1", "spans": [{ "voice_id": "b", "text": "", "pause_ms_after": 1000 }, { "voice_id": "b", "text": "c" }] }] },
    { "name": "voice_marker_alone_leaves_nothing", "input": "[voice:a]", "expected": [] },
    { "name": "voice_marker_at_the_end_leaves_nothing_extra", "input": "x[voice:a]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "x" }] }] },
    { "name": "whitespace_between_voice_markers_is_dropped", "input": "[voice:a] \n [voice:b]x",
      "expected": [{ "title": "Chapter 1", "spans": [{ "voice_id": "b", "text": "x" }] }] },
    { "name": "voice_with_default_speed", "input": "[voice:a]x", "options": { "defaultSpeed": 1.1 },
      "expected": [{ "title": "Chapter 1", "spans": [{ "voice_id": "a", "text": "x", "speed": 1.1 }] }] },
    { "name": "voice_name_cannot_contain_brackets", "input": "[voice:a[b]y",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "[voice:a[b]y" }] }] },
    { "name": "voice_marker_needs_the_colon", "input": "[voice a]x",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "[voice a]x" }] }] },
    { "name": "voice_does_not_cross_a_chapter", "input": "# A\n[voice:b]x\n# B\ny",
      "expected": [
        { "title": "A", "spans": [{ "voice_id": "b", "text": "x" }] },
        { "title": "B", "spans": [{ "text": "y" }] }] },
    { "name": "voice_marker_in_a_title_is_literal", "input": "# [voice:a] T\nx",
      "expected": [{ "title": "[voice:a] T", "spans": [{ "text": "x" }] }] },

    { "name": "slow_tag", "input": "[slow]abc[/slow]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "abc", "speed": 0.85 }] }] },
    { "name": "fast_tag", "input": "[fast]abc[/fast]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "abc", "speed": 1.15 }] }] },
    { "name": "emphasis_tag_is_a_speed", "input": "[emphasis]abc[/emphasis]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "abc", "speed": 0.92 }] }] },
    { "name": "tag_keywords_are_case_insensitive", "input": "[SLOW]a[/Slow]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "speed": 0.85 }] }] },
    { "name": "tag_splits_a_line", "input": "x [slow]y[/slow] z",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "x", "join": "continue" }, { "text": "y", "speed": 0.85, "join": "continue" }, { "text": "z" }] }] },
    { "name": "tag_at_the_start_and_the_end", "input": "[slow]a[/slow] b [fast]c[/fast]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "speed": 0.85, "join": "continue" }, { "text": "b", "join": "continue" }, { "text": "c", "speed": 1.15 }] }] },
    { "name": "tag_overrides_the_default_speed", "input": "x [slow]y[/slow] z", "options": { "defaultSpeed": 1.1 },
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "x", "speed": 1.1, "join": "continue" }, { "text": "y", "speed": 0.85, "join": "continue" }, { "text": "z", "speed": 1.1 }] }] },
    { "name": "unclosed_tag_runs_to_the_end_of_the_text", "input": "a [slow]b c",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "join": "continue" }, { "text": "b c", "speed": 0.85 }] }] },
    { "name": "stray_close_is_ignored", "input": "a[/slow]b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "ab" }] }] },
    { "name": "empty_tag_pair_leaves_nothing", "input": "a[slow][/slow]b",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "ab" }] }] },
    { "name": "adjacent_equal_tags_merge", "input": "[slow]a[/slow][slow]b[/slow]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "ab", "speed": 0.85 }] }] },
    { "name": "tag_text_may_span_lines", "input": "[slow]line1\nline2[/slow]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "line1\nline2", "speed": 0.85 }] }] },
    { "name": "whitespace_inside_a_tag_is_trimmed", "input": "  [slow] a [/slow]  ",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "speed": 0.85 }] }] },
    { "name": "nested_tags_the_innermost_wins", "input": "[slow]a[fast]b[/fast]c[/slow]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "speed": 0.85, "join": "continue" }, { "text": "b", "speed": 1.15, "join": "continue" }, { "text": "c", "speed": 0.85 }] }] },
    { "name": "nested_tags_the_inner_emphasis_wins", "input": "[slow][emphasis]x[/emphasis][/slow]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "x", "speed": 0.92 }] }] },
    { "name": "nested_tags_the_inner_slow_wins", "input": "[emphasis][slow]x[/slow][/emphasis]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "x", "speed": 0.85 }] }] },
    { "name": "crossing_tags_close_the_one_they_name", "input": "[slow]a[fast]b[/slow]c[/fast]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "speed": 0.85, "join": "continue" }, { "text": "bc", "speed": 1.15 }] }] },
    { "name": "emphasis_keeps_equal_speech_apart", "input": "[emphasis][slow]x[/slow][/emphasis][slow]y[/slow]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "x", "speed": 0.85, "join": "continue" }, { "text": "y", "speed": 0.85 }] }] },
    { "name": "plain_text_between_equal_tags_keeps_them_apart", "input": "[slow]a[/slow] [slow]b[/slow]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "speed": 0.85, "join": "continue" }, { "text": "b", "speed": 0.85 }] }] },
    { "name": "tag_does_not_cross_a_pause", "input": "[slow]abc [pause 1s] def[/slow]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "abc", "speed": 0.85, "pause_ms_after": 1000 }, { "text": "def" }] }] },
    { "name": "tag_does_not_cross_a_voice_marker", "input": "[slow]a[voice:b]c[/slow]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "speed": 0.85 }, { "voice_id": "b", "text": "c" }] }] },
    { "name": "pause_inside_a_tag_leaves_the_tag_on_the_first_part", "input": "[fast]a[pause 1s]b[/fast]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "a", "speed": 1.15, "pause_ms_after": 1000 }, { "text": "b" }] }] },
    { "name": "tag_names_must_be_exact", "input": "[slowly]x [ slow ]y [slow x]z [/ slow]w",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "[slowly]x [ slow ]y [slow x]z [/ slow]w" }] }] },
    { "name": "unknown_tag_is_text", "input": "[loud]x[/loud]",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "[loud]x[/loud]" }] }] },

    { "name": "spell_tag", "input": "[spell]USA[/spell] ok",
      "expected": [{ "title": "Chapter 1", "spans": [{ "text": "U S A", "join": "continue" }, { "text": "ok" }] }] },
    { "name": "spell_removes_all_whitespace_first", "input": "[spell]a b\nc[/spell]",
